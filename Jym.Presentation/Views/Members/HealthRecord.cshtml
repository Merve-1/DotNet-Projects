@using Jym.BusinessLogic.ViewModels.HealthRecords
@model HealthRecordDetailsViewModel

@{
    ViewData["Title"] = "Health Record";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-details border-0 p-4 shadow">
                <div class="card-body">
                    <h3 class="mb-4 text-primary-color text-center">Health Record</h3>

                    <div class="row g-3">
                        <div class="col-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block mb-1">Height</small>
                                <strong>@Model.Height cm</strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block mb-1">Weight</small>
                                <strong>@Model.Weight kg</strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block mb-1">Blood Type</small>
                                <strong>@Model.BloodType</strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block mb-1">Note</small>
                                <strong>@(string.IsNullOrWhiteSpace(Model.Note) ? "-" : Model.Note)</strong>
                            </div>
                        </div>
                    </div>

                    <a asp-controller="Members" asp-action="Index" class="btn btn-outline-secondary mt-4">
                        Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
