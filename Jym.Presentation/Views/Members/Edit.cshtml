@using Jym.BusinessLogic.ViewModels.Members
@model EditMemberViewModel

@{
    ViewData["Title"] = "Edit Member";
}

<div class="container">
    <main role="main" class="pb-3">

        <header class="mb-4">
            <h3 class="text-primary-color">Edit Member</h3>
        </header>

        <form asp-controller="Members" asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Name can't be changed here -> keep it read-only, but still post it back
                 unchanged (a disabled input wouldn't post at all). -->
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Name" />
            <input type="hidden" asp-for="PhotoUrl" />

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control" value="@Model.Name" readonly disabled />
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="BuildingNumber" class="form-label"></label>
                    <input asp-for="BuildingNumber" class="form-control" />
                    <span asp-validation-for="BuildingNumber" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="Street" class="form-label"></label>
                    <input asp-for="Street" class="form-control" />
                    <span asp-validation-for="Street" class="text-danger"></span>
                </div>
            </div>

            <footer class="d-flex justify-content-end gap-3 mt-4">
                <a asp-controller="Members" asp-action="Index" class="btn btn-outline-secondary px-4">
                    Back to List
                </a>
                <button type="submit" class="btn btn-primary px-4">
                    Done
                </button>
            </footer>
        </form>

    </main>
</div>

@section ValidationScripts {
    <partial name="_ValidationScriptsPartial" />
}
